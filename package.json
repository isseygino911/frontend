{
  "name": "ii-design-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"cd ../editor/apps/editor && npm run dev\" --names \"vite,editor\" --kill-others",
    "build": "cd ../editor/apps/editor && npm run build && cd ../../../frontend && rm -rf public/editor && mkdir -p public/editor && cp -r ../editor/apps/editor/out/. public/editor && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "jsdom": "^25.0.1",
    "vite": "^5.3.1",
    "vitest": "^2.1.9"
  }
}
